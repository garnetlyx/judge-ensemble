{
  "name": "judge-ensemble",
  "version": "0.1.1",
  "description": "Run N concurrent judges under a hard time budget — always get exactly N labeled results (real | substitute | fallback), streamed as they land, with abort cascades that never waste in-flight calls.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test",
    "prepare": "npm run build"
  },
  "keywords": [
    "llm-as-judge",
    "judge",
    "ensemble",
    "jury",
    "panel",
    "fanout",
    "timeout",
    "fallback",
    "retry",
    "abort",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garnetlyx/judge-ensemble.git"
  },
  "homepage": "https://github.com/garnetlyx/judge-ensemble#readme",
  "bugs": {
    "url": "https://github.com/garnetlyx/judge-ensemble/issues"
  },
  "author": "Garnet Liu",
  "sideEffects": false
}
